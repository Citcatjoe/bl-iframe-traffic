# Mini-écosystème (voir PLAN-ECOSYSTEME.md) : un VPS, plusieurs widgets de données.
# Par projet <p> :  https://<hôte>/<p>/       → widget  (/srv/sites/<p>/current)
#                   https://<hôte>/<p>/feed/  → données (/srv/feeds/<p>, écrites par le poller)
# Installation : sudo cp deploy/ecosysteme/Caddyfile /etc/caddy/Caddyfile, adapter l'e-mail et l'adresse,
# puis sudo systemctl reload caddy
{
	email remplacer@example.ch
}

(projet) {
	handle_path /{args[0]}/feed/* {
		root * /srv/feeds/{args[0]}
		header Cache-Control "public, max-age=60, stale-while-revalidate=120, stale-if-error=86400"
		header Access-Control-Allow-Origin "*"
		file_server
	}
	handle_path /{args[0]}/* {
		root * /srv/sites/{args[0]}/current
		# Fichiers compilés par Vite : nom haché, donc cachables un an.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	redir /{args[0]} /{args[0]}/ 308
}

# Sans nom de domaine : certificat Let's Encrypt pour l'adresse IP (6 jours, renouvelé par Caddy).
# Avec un nom : remplacer la ligne d'adresse par le nom et supprimer le bloc tls.
https://203.0.113.10 {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	encode zstd gzip

	import projet trafic
	import projet meteo

	handle {
		respond 404
	}
}
